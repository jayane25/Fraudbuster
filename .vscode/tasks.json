{
  // Terminal > Run Task...  "Setup" installs everything on a new laptop.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: create .venv and install packages",
      "type": "shell",
      "windows": { "command": "py -3 -m venv .venv; .venv\\Scripts\\python -m pip install -r requirements.txt" },
      "osx": { "command": "python3 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt" },
      "linux": { "command": "python3 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt" },
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "windows": { "command": ".venv\\Scripts\\python -m pytest tests -v" },
      "osx": { "command": ".venv/bin/python -m pytest tests -v" },
      "linux": { "command": ".venv/bin/python -m pytest tests -v" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
